{
  "title": "Astra X — Application Dashboard",
  "uid": "astra-x-app",
  "tags": ["astra-x", "fastapi"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(astra_x_http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1
        }
      }
    },
    {
      "title": "P99 / P95 / P50 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(astra_x_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(astra_x_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(astra_x_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        }
      }
    },
    {
      "title": "In-Flight Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "astra_x_http_requests_in_flight",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "title": "HTTP Status Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(astra_x_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Active Conversations",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 8 },
      "targets": [
        { "expr": "astra_x_active_conversations" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 100, "color": "orange" }, { "value": 500, "color": "red" } ] }
        }
      }
    },
    {
      "title": "WebSocket Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "targets": [
        { "expr": "astra_x_websocket_connections" }
      ]
    },
    {
      "title": "LLM Token Usage Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(astra_x_llm_tokens_total[1m])",
          "legendFormat": "{{provider}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "title": "Rate Limit Hits",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(astra_x_rate_limit_hits_total[5m])",
          "legendFormat": "{{key_prefix}}"
        }
      ]
    },
    {
      "title": "Auth Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "expr": "rate(astra_x_auth_failures_total[5m])",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
