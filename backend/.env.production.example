# =============================================================================
# Astra X — Production Environment Configuration
# =============================================================================
# Copy to .env.production and fill in every value marked 🔒.
# Secrets should use Docker secrets, Vault, or K8s Secrets, not plaintext env
# files. The env file is used here as a fallback for docker-compose.
#
# Production-safety validators in app/config/settings.py enforce:
#   • secret_key ≥ 32 chars and not the dev default
#   • debug = false
#   • allowed_hosts must not contain "*"
#   • cors_origins must not contain "*"
# =============================================================================

# --- Application identity ---
ASTRA_ENVIRONMENT=production
ASTRA_DEBUG=false
ASTRA_APP_NAME=Astra_X
ASTRA_APP_VERSION=0.1.0
ASTRA_API_V1_PREFIX=/api/v1

# --- Server ---
ASTRA_HOST=0.0.0.0
ASTRA_PORT=8000

# --- Logging ---
ASTRA_LOG_LEVEL=INFO
ASTRA_LOG_FORMAT=json              # JSON for structured logging in production

# --- Security ---
# 🔒 Generate a strong random key:  python -c "import secrets; print(secrets.token_hex(32))"
ASTRA_SECRET_KEY=change-me-to-a-random-64-char-hex-string
ASTRA_ALLOWED_HOSTS=api.astra-x.example.com
ASTRA_CORS_ORIGINS=https://astra-x.example.com
ASTRA_CORS_ALLOW_CREDENTIALS=true
ASTRA_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Database ---
# 🔒 Use a restricted PostgreSQL user, not the superuser.
ASTRA_DATABASE_URL=postgresql+asyncpg://astra:astra@db:5432/astra
ASTRA_DATABASE_ECHO=false
ASTRA_DATABASE_POOL_SIZE=10

# --- LLM providers ---
ASTRA_DEFAULT_LLM_PROVIDER=ollama
ASTRA_DEFAULT_LLM_MODEL=llama3.1
ASTRA_LLM_REQUEST_TIMEOUT_SECONDS=120.0
ASTRA_OLLAMA_BASE_URL=http://ollama:11434
ASTRA_LM_STUDIO_BASE_URL=http://lm-studio:1234/v1
ASTRA_OPENAI_COMPATIBLE_BASE_URL=
ASTRA_OPENAI_COMPATIBLE_API_KEY=

# --- Embeddings ---
ASTRA_EMBEDDING_PROVIDER=ollama
ASTRA_EMBEDDING_MODEL=nomic-embed-text
ASTRA_EMBEDDING_DIMENSIONS=768
