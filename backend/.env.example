# ASTRA_X Backend — Environment Configuration
# Copy this file to .env and adjust values for your setup.
# Boolean/list fields accept comma-separated strings (e.g. "a,b,c").
#
# SECURITY: Never commit .env to version control. The .env.example file
# is safe to commit as it contains no real secrets.
#
# For production deployments, use Docker Secrets or Kubernetes Secrets
# to inject sensitive values (see docker-compose.prod.yml and k8s/).

# --- Application identity ---
ASTRA_ENVIRONMENT=development            # Runtime environment: development, testing, production
ASTRA_DEBUG=false                        # Enable verbose diagnostics (MUST be false in production)
ASTRA_APP_NAME=Astra_X                   # Human-readable app name
ASTRA_APP_VERSION=0.1.0                  # Semantic version
ASTRA_API_V1_PREFIX=/api/v1             # URL prefix for v1 HTTP API

# --- Server ---
ASTRA_HOST=127.0.0.1                    # Interface to bind to
ASTRA_PORT=8000                          # TCP port to listen on

# --- Logging ---
ASTRA_LOG_LEVEL=INFO                     # Minimum log severity: DEBUG, INFO, WARNING, ERROR, CRITICAL
ASTRA_LOG_FORMAT=console                 # Output format: console (human-readable), json (structured)

# --- Security ---
# Generate a 64-character hex secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
ASTRA_SECRET_KEY=                        # Cryptographic secret — MUST be 64-char hex in production
ASTRA_ALLOWED_HOSTS=localhost,127.0.0.1  # Hostnames the server accepts requests for (comma-sep)
ASTRA_CORS_ORIGINS=http://localhost:5173  # Origins permitted for CORS (comma-sep, no wildcard in prod)
ASTRA_CORS_ALLOW_CREDENTIALS=true        # Whether to include credentials in CORS responses
ASTRA_RATE_LIMIT_REQUESTS_PER_MINUTE=60  # Request budget per client per minute

# --- Database ---
# For PostgreSQL (production):
#   ASTRA_DATABASE_URL=postgresql+asyncpg://astra:<password>@db:5432/astra
# Or mount via Docker Secret:
#   ASTRA_DATABASE_URL_FILE=/run/secrets/astra_database_url
ASTRA_DATABASE_URL=sqlite+aiosqlite:///./astra_x.db
                                         # Async SQLAlchemy database URL
ASTRA_DATABASE_ECHO=false                # Log every SQL statement (development only)
ASTRA_DATABASE_POOL_SIZE=5               # Connection pool size (PostgreSQL)
# Required for Docker Compose PostgreSQL:
ASTRA_POSTGRES_PASSWORD=                 # Postgres password (used in docker-compose.yml)

# --- LLM providers ---
ASTRA_DEFAULT_LLM_PROVIDER=ollama        # Default provider adapter identifier
ASTRA_DEFAULT_LLM_MODEL=llama3.1         # Default model name to use
ASTRA_LLM_REQUEST_TIMEOUT_SECONDS=60.0   # Max seconds to wait for a provider response
ASTRA_OLLAMA_BASE_URL=http://localhost:11434
                                         # Base URL for local Ollama server
ASTRA_LM_STUDIO_BASE_URL=http://localhost:1234/v1
                                         # Base URL for local LM Studio server
ASTRA_OPENAI_COMPATIBLE_BASE_URL=        # Base URL for generic OpenAI-compatible API (optional)
ASTRA_OPENAI_COMPATIBLE_API_KEY=         # API key for OpenAI-compatible provider (optional)

# --- Embeddings ---
ASTRA_EMBEDDING_PROVIDER=ollama           # Embedding provider: ollama, openai, sentence_transformers
ASTRA_EMBEDDING_MODEL=nomic-embed-text    # Embedding model name
ASTRA_EMBEDDING_DIMENSIONS=768            # Embedding vector dimensionality
